# ============================================================
# BVĐK KHU VỰC THỚI LAI - PRODUCTION ENVIRONMENT TEMPLATE
# Không commit file .env thật lên Git.
# ============================================================
NODE_ENV=production

# URL công khai bắt buộc dùng HTTPS
NEXT_PUBLIC_SITE_URL=https://benhvienthoilai.vn

# PostgreSQL runtime. Với Neon có thể dùng pooled URL (hostname chứa -pooler).
DATABASE_URL=postgresql://postgres:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/thoi_lai_hospital?sslmode=require
# Bắt buộc khi DATABASE_URL dùng Neon pooler: Direct connection string, hostname KHÔNG có -pooler.
# Biến này chỉ dùng cho migration/DDL; không in ra log và không commit giá trị thật.
DATABASE_MIGRATION_URL=postgresql://postgres:CHANGE_ME@ep-example.ap-southeast-1.aws.neon.tech/thoi_lai_hospital?sslmode=require
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
PAYLOAD_DB_PUSH=false

# Giới hạn thời gian cho Railway Pre-Deploy migration
DB_MIGRATION_CONNECTION_TIMEOUT_MS=15000
DB_MIGRATION_LOCK_WAIT_MS=60000
DB_MIGRATION_DB_LOCK_TIMEOUT_MS=30000
DB_MIGRATION_STATEMENT_TIMEOUT_MS=240000

# Tối thiểu 32 ký tự, nên dùng chuỗi ngẫu nhiên dài 64+ ký tự.
PAYLOAD_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
PREVIEW_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET_32_CHARS

# Các tích hợp công khai
NEXT_PUBLIC_MEDPRO_URL=https://medpro.vn/
NEXT_PUBLIC_HOTLINE=
NEXT_PUBLIC_ZALO_URL=

# Cloudflare Turnstile (Bắt buộc trên Production để chống bot/spam đặt lịch & biểu mẫu)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_CHANGE_ME
TURNSTILE_SECRET_KEY=0x4AAAAAAA_CHANGE_ME

# Tùy chọn
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# Chỉ dùng khi seed môi trường mới; không để mật khẩu mặc định.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
