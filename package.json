    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@types/nodemailer": "^8.0.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "payload": "3.89.0",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.4"
