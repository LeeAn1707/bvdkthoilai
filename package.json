    "backup:verify": "sh scripts/verify-backup.sh",
    "validate:system-hardening": "node scripts/validate-system-hardening.mjs",
    "validate:uat-production": "node scripts/validate-uat-production.mjs",
    "validate:all": "npm run validate:foundation && npm run validate:site-shell && npm run validate:public-content && npm run validate:patient-services && npm run validate:organization && npm run validate:homepage-seo-search && npm run validate:chatbot-forms-feedback && npm run validate:quality-surveys && npm run validate:migrations && npm run validate:system-hardening && npm run validate:uat-production",
    "preflight:production": "node scripts/preflight-production.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "deploy:check": "npm run validate:all && npm run preflight:production && npm run typecheck && npm run build",
    "validate:production-security": "node scripts/validate-production-security-v430.mjs",
    "validate:content-consistency": "node scripts/validate-content-consistency.mjs",
    "validate:smart-links": "node scripts/validate-smart-links.mjs",
    "audit:legacy": "node scripts/migrate-legacy-data.mjs",
    "migrate:legacy": "node scripts/migrate-legacy-data.mjs",
    "audit:visibility": "node scripts/repair-payload-version-visibility.mjs",
    "repair:visibility": "node scripts/repair-payload-version-visibility.mjs",
    "audit:header-settings": "node scripts/upgrade-header-settings.mjs",
    "upgrade:header-settings": "node scripts/upgrade-header-settings.mjs",
